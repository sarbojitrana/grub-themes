# {{.Name}} — a GRUB2 theme.
#
# `grub-themes build {{.ID}}` reads this and generates every PNG and .pf2,
# correctly encoded. See docs/build-your-own-theme.md.

[theme]
id          = "{{.ID}}"
name        = "{{.Name}}"
description = "A short line describing how it looks."
version     = "0.1.0"
license     = "MIT"
tags        = ["dark"]

[author]
name   = "{{.Author}}"
github = "{{.GitHub}}"

[files]
entry   = "theme.txt"
preview = "preview.png"

[display]
# What the art was drawn for; GRUB scales it, and theme.txt is in percentages.
designed_for = "1920x1080"
aspect       = "16:9"

# --- assets: generated. Edit the values here, not the files. --------------

[assets.background]
# The art: yours. Edit the SVG and rebuild.
source = "tools/background.svg"
width  = 1920
height = 1080

[assets.selection]
# The highlight behind the selected entry. style = pill | bar | underline |
# none; add shadow/shadow_dx/shadow_dy for an offset ghost behind it.
style  = "pill"
fill   = "{{.Accent}}"
text   = "#0b0f14"     # must contrast with fill; lint checks it
radius = 10
height = 44            # keep equal to item_height in theme.txt

[assets.terminal_box]
# Transparent: GRUB paints this box while the kernel loads.
fill = "transparent"

[assets.progress]
track = "#141c24e6"
fill  = "{{.Accent}}"

[assets.fonts]
# build prints the baked names; theme.txt must use those exactly.
regular    = "JetBrainsMonoNerdFont-Regular.ttf"
bold       = "JetBrainsMonoNerdFont-Bold.ttf"
prefix     = "font"
sizes      = [12, 14, 20]
bold_sizes = [18]
